# ============================================================================
# Backend configuration. Copy this file to ".env" and fill in what you need.
# The app RUNS WITH ZERO CHANGES: without keys it uses safe local fallbacks
# (SQLite, offline embeddings, a local LLM, file-based email). Add keys below
# to switch on the real providers -- no code changes required.
# ============================================================================

APP_ENV=development
API_PREFIX=/api/v1

# Comma-separated origins allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Security (CHANGE THESE FOR ANY REAL DEPLOYMENT) ---
JWT_SECRET=change-me-in-production-please-set-JWT_SECRET
# Bootstrap admin, created automatically on first startup:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Library Admin

# --- Database ---
# Default (leave blank/omit) = local SQLite file at backend/data/library.db.
# To use PostgreSQL + pgvector instead, set e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/library_assistant
# DATABASE_URL=

# --- LLM: OpenAI (used automatically when a key is present) ---
# You can also set the standard OPENAI_API_KEY variable instead of LLM_API_KEY.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # optional, for Azure/OpenAI-compatible gateways

# --- Embeddings (OpenAI text-embedding-3-small) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Research (SerpAPI Google Scholar) ---
SERPAPI_API_KEY=

# --- Email / SMTP (used when SMTP_HOST + SMTP_USERNAME are set) ---
# Without SMTP, reminder emails are written to backend/data/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=library-no-reply@example.com
SUPPORT_EMAIL=support@example.com

# --- Loans / reminders ---
LOAN_PERIOD_DAYS=14
REMINDER_CADENCE=once          # "once" or "daily"
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
