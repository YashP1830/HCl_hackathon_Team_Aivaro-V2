# Backend configuration; copy to .env and fill in your local values.
APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Security: override for any deployment
JWT_SECRET=change-me-in-production-please-set-JWT_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Library Admin

# Database defaults to local SQLite if DATABASE_URL is omitted.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/library_assistant

# LangChain ChatOpenAI and OpenAIEmbeddings
# LLM_API_KEY is used by the app; OPENAI_API_KEY is also accepted.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=  # optional OpenAI-compatible endpoint
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_TIMEOUT_SECONDS=30

# SerpAPI Google Scholar
SERPAPI_API_KEY=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=library-no-reply@example.com
SUPPORT_EMAIL=support@example.com

# Loans / reminders
LOAN_PERIOD_DAYS=14
REMINDER_CADENCE=once
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
